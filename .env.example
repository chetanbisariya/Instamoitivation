# ==========================================
# Instagram Motivation Video Agent Configuration
# ==========================================

# Branding & Social Handles
INSTAGRAM_HANDLE=@stoic.discipline.daily
DEFAULT_TOPIC="DAILY DISCIPLINE"

# ElevenLabs Voice AI (Get key from https://elevenlabs.io)
# Voice ID options:
# - pNInz6obpgDQGcFmaJgB (Adam - Deep, Grounded, Motivational)
# - ErXwobaYiN019PkySvjV (Antoni - Crisp, Narrative)
# - 21m00Tcm4TlvDq8ikWAM (Rachel - Calm, Clear)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Fallback TTS Voice (Free Edge-TTS used when ElevenLabs is not configured)
FALLBACK_TTS_VOICE=en-US-ChristopherNeural

# Google Gemini API Key (Optional - for generating novel AI quotes and hooks)
# If left empty, a rich curated database of 50+ stoic masterclass scripts is used automatically
GEMINI_API_KEY=

# Social Scheduler: Buffer Integration
# (Get token from https://buffer.com/developers)
BUFFER_ACCESS_TOKEN=
BUFFER_PROFILE_ID=

# Social Scheduler: Custom Webhook
# (Make.com, Zapier, n8n, or custom server endpoint)
WEBHOOK_URL=

# Daily Automation Run Time (24h format, e.g. 09:00 for 9 AM)
SCHEDULE_TIME=09:00

# Video Parameters
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
BACKGROUND_MUSIC_VOLUME=0.14
